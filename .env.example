# RegIntelGraph — environment template. PLACEHOLDERS ONLY. Never put real values here.
# Copy to .env (git-ignored) for local use.

RIG_ENV=local
RIG_LOG_LEVEL=INFO

# Core test suite must run with RIG_OFFLINE_TESTS=1 and zero paid-API access.
RIG_OFFLINE_TESTS=1

# PostgreSQL system of record (placeholder credentials)
RIG_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/regintelgraph

# Raw-document blob store (content-addressed; local filesystem initially)
RIG_BLOB_ROOT=./local_data/blobs

# Quarantine blob store: MUST be a directory disjoint from RIG_BLOB_ROOT (never nested in it, never the same). Required by the ingestion CLI's LIVE mode.
RIG_QUARANTINE_ROOT=./local_data/quarantine

# Model providers: "none" = deterministic stubs only (default for tests/CI)
RIG_LLM_PROVIDER=none
RIG_LLM_API_KEY=
RIG_EMBEDDER=hash-stub
RIG_RERANKER=none

# Crawler politeness / contact (set before any live crawl; see docs/ingestion-design.md)
RIG_CRAWLER_CONTACT_EMAIL=
